# ============================================================
# Gayrimenkul Admin — Ortam Konfigürasyonu (Example)
# ============================================================
# Development Ortamı İçin (Lokal Testler)
# API_BASE_URL=http://localhost:3001
# APP_ENV=development
# DEBUG=true
#
# Production Ortamı İçin (Canlı Sunucu Build'i öncesi)
# API_BASE_URL=https://api.domain.com
# APP_ENV=production
# DEBUG=false
# ============================================================

# Backend API Endpoint
API_BASE_URL=http://localhost:3001
API_VERSION=v1
API_TIMEOUT=30

# Uygulama Bilgileri
APP_NAME=Gayrimenkul Admin
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
