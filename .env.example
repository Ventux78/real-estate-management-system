# ─────────────────────────────────────────────────────────
# PRODUCTION & DEVELOPMENT ENVIRONMENT VARIABLES
# ─────────────────────────────────────────────────────────
# Bu dosya ortam değişkenleri için bir şablondur.
# Production için '.env' dosyasına kopyalayıp değerleri doldurun.

# ── GENERAL ──
NODE_ENV=production
# development | production | test

# ── DATABASE ──
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_NAME=gayrimenkul
# Uygulama içinde Prisma tarafından kullanılacak URL
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@localhost:5432/${DB_NAME}?schema=public
# Docker Compose kullanılıyorsa host 'localhost' yerine 'postgres' olmalı:
# DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@postgres:5432/${DB_NAME}?schema=public

# ── BACKEND API ──
PORT=5000
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:3000

# ── FRONTEND ──
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
# Production'da alan adınız olmalı: https://api.domain.com/v1

# ── CLOUDINARY (Resim Yükleme) ──
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
